generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  VENDOR
  BUSINESS
  ADMIN
}

enum RegistrationType {
  BUYER
  SELLER
  BUSINESS
}

enum AuthProvider {
  PHONE
  EMAIL
  GOOGLE
  APPLE
  FACEBOOK
}

enum EmailOtpPurpose {
  REGISTRATION
  EMAIL_CHANGE
  PASSWORD_RESET
}

enum PhoneOtpPurpose {
  PHONE_CHANGE
  REGISTRATION
  PASSWORD_RESET
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstName   String?
  lastName    String?
  dateOfBirth String?
  address     String?
  city        String?
  state       String?
  countryCode String?
  avatarUrl   String?

  email        String? @unique
  passwordHash String?

  phone String? @unique

  productComment ProductComment[]

  authProvider AuthProvider?

  registrationType RegistrationType?

  role UserRole @default(CUSTOMER)

  isVerified           Boolean               @default(false)
  isActive             Boolean               @default(true)
  emailVerified        Boolean               @default(false)
  referralCode         String?               @unique
  referredBy           Referral?             @relation("Referee")
  merchantSubscription MerchantSubscription?

  notificationReads    SellerNotificationRead[]
  notificationSettings SellerNotificationSettings?
  vendorProfile        VendorProfile?
  wallet               Wallet?
  referrals            Referral[]                  @relation("Referrer")
  cartItems            CommerceCartItem[]
  orders               CommerceOrder[]
  orderIssues          OrderIssue[]
  returnRequests       ReturnRequest[]
  trustReviews         VendorTrustReview[]         @relation("TrustReviewer")
  reviewVotes          VendorReviewVote[]
  productLikes         ProductLike[]
  merchantContacts     MerchantContact[]
  productReviews       ProductReview[]
  productReviewVotes   ProductReviewVote[]
  buyerConversations   Conversation[]              @relation("ConversationBuyer")
  sentMessages         ChatMessage[]               @relation("MessageSender")
  supportTickets       SupportTicket[]             @relation("SupportTicketOwner")
  supportMessages      SupportMessage[]            @relation("SupportMessageSender")

  //User shopping intrests
  interests               Interest[]
  sellerFulfillmentEvents SellerFulfillmentEvent[]

  @@index([email])
  @@index([phone])
  @@index([registrationType])
  @@index([role])
}

model Interest {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  user User[]
}

enum WalletTransactionType {
  FUNDING
  PURCHASE
  REFERRAL_BONUS
  WITHDRAWAL
}

enum WalletTransactionStatus {
  COMPLETED
  FAILED
  PENDING
}

model Wallet {
  id               String              @id @default(uuid())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  userId           String              @unique
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableBalance Int                 @default(0)
  mainBalance      Int                 @default(0)
  referralBonus    Int                 @default(0)
  accountName      String?
  accountNumber    String?             @unique
  bankName         String?
  transactions     WalletTransaction[]
}

model WalletTransaction {
  id             String                  @id @default(uuid())
  createdAt      DateTime                @default(now())
  walletId       String
  wallet         Wallet                  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount         Int
  description    String
  type           WalletTransactionType
  status         WalletTransactionStatus @default(COMPLETED)
  referralReward ReferralReward?

  @@index([walletId, createdAt])
  @@index([status])
}

enum ReferralStatus {
  COMPLETED
  PENDING
}

model Referral {
  id             String           @id @default(uuid())
  createdAt      DateTime         @default(now())
  referrerUserId String
  referrer       User             @relation("Referrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  refereeName    String
  rewardAmount   Int              @default(500)
  status         ReferralStatus   @default(PENDING)
  completedAt    DateTime?
  refereeUserId  String?          @unique
  referee        User?            @relation("Referee", fields: [refereeUserId], references: [id], onDelete: SetNull)
  rewards        ReferralReward[]

  @@index([referrerUserId, createdAt])
  @@index([status])
}

model MerchantSubscription {
  id             String                @id @default(uuid())
  userId         String                @unique
  user           User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  trialStartedAt DateTime
  trialEndsAt    DateTime
  payments       SubscriptionPayment[]
}

model SubscriptionPayment {
  id             String               @id @default(uuid())
  checkoutUrl    String?
  subscriptionId String
  subscription   MerchantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  reference      String               @unique
  period         Int
  amount         Int
  paidAt         DateTime?
  createdAt      DateTime             @default(now())
  reward         ReferralReward?

  @@unique([subscriptionId, period])
}

model ReferralReward {
  id            String              @id @default(uuid())
  createdAt     DateTime            @default(now())
  referralId    String
  referral      Referral            @relation(fields: [referralId], references: [id], onDelete: Restrict)
  paymentId     String              @unique
  payment       SubscriptionPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  transactionId String              @unique
  transaction   WalletTransaction   @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  amount        Int

  @@index([referralId, createdAt])
}

model PhoneOtp {
  id         String          @id @default(cuid())
  phone      String
  pinId      String?
  codeHash   String?
  expiresAt  DateTime
  attempts   Int             @default(0)
  verified   Boolean         @default(false)
  purpose    PhoneOtpPurpose @default(REGISTRATION)
  consumedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([phone, purpose])
}

model EmailOtp {
  id         String          @id @default(cuid())
  email      String
  userId     String?
  codeHash   String
  expiresAt  DateTime
  attempts   Int             @default(0)
  verified   Boolean         @default(false)
  consumedAt DateTime?
  purpose    EmailOtpPurpose
  createdAt  DateTime        @default(now())

  @@index([email, purpose])
  @@index([userId, purpose])
}

enum VendorReviewStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model VendorProfile {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeName          String
  category           String
  subCategory        String
  state              String
  city               String
  lga                String
  address            String
  landmark           String?
  description        String
  about              String?
  socialLinks        Json               @default("[]")
  representativeName String?
  representativeRole String?
  representativeBio  String?
  logoUrl            String?
  bannerUrl          String?
  cacUrl             String?
  bankName           String?
  bankCode           String?
  bankAccountNumber  String?
  bankAccountName    String?
  sellerType         String?
  termsAcceptedAt    DateTime?
  submittedAt        DateTime?
  reviewStatus       VendorReviewStatus @default(DRAFT)
  setupCompleted     Boolean            @default(false)

  featuredProductId String?

  products           Product[]
  categories         VendorCategory[]
  trustReviews       VendorTrustReview[]
  offers             Offer[]
  conversations      Conversation[]
  paymentConnections MerchantPaymentConnection[]
  invoices           GoodsInvoice[]
  contacts           MerchantContact[]
  content            MerchantContent[]

  @@index([category])
  @@index([state, city])
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
  DELETED
}

model VendorCategory {
  id              String           @id @default(uuid())
  createdAt       DateTime         @default(now())
  name            String
  parentId        String?
  parent          VendorCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        VendorCategory[] @relation("CategoryTree")
  products        Product[]
  vendorProfileId String
  vendorProfile   VendorProfile    @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  @@unique([vendorProfileId, name])
  @@index([vendorProfileId, createdAt])
  @@index([parentId])
}

model Product {
  id        String          @id @default(uuid())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  aisleId   String?
  aisle     VendorCategory? @relation(fields: [aisleId], references: [id], onDelete: SetNull)

  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  comments       ProductComment[]
  category       String
  mainCategory   String?
  subCategories  String[]         @default([])
  name           String
  description    String?
  specifications Json             @default("{}")
  unitPrice      Int
  promoPrice     Int?
  promoStartsAt  DateTime?
  promoEndsAt    DateTime?
  quantity       Int
  variants       Json             @default("[]")
  imageUrls      String[]
  status         ProductStatus    @default(ACTIVE)

  cartItems CommerceCartItem[]
  likes     ProductLike[]
  offers    OfferProduct[]
  reviews   ProductReview[]

  @@index([vendorProfileId, status])
  @@index([category])
  @@index([createdAt])
  @@index([promoStartsAt, promoEndsAt])
  @@index([aisleId])
}

enum OfferType {
  PRICE_DISCOUNT
  BUNDLE_DEAL
  DELIVERY
  FLASH_SALE
}

enum OfferStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
}

enum OfferDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FIXED_PRICE
}

enum DeliveryOfferType {
  FREE
  REDUCED
}

model Offer {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  type                OfferType
  status              OfferStatus        @default(ACTIVE)
  name                String?
  description         String?
  mediaUrls           String[]           @default([])
  stockLimit          Int?
  unitsClaimed        Int                @default(0)
  createRequestId     String?            @unique
  discountType        OfferDiscountType?
  discountValue       Int?
  bundlePrice         Int?
  deliveryType        DeliveryOfferType?
  deliveryFee         Int?
  minimumOrderValue   Int?
  applicableLocations String[]           @default([])
  startsAt            DateTime           @default(now())
  endsAt              DateTime

  products OfferProduct[]

  @@index([vendorProfileId, status, createdAt])
  @@index([startsAt, endsAt])
}

model OfferProduct {
  offerId   String
  offer     Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([offerId, productId])
  @@index([productId])
}

enum ChatMessageKind {
  TEXT
  IMAGE
  VOICE
}

enum ConversationStatus {
  OPEN
  PENDING
  COMPLETED
}

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyerUserId      String
  buyer            User               @relation("ConversationBuyer", fields: [buyerUserId], references: [id], onDelete: Cascade)
  vendorProfileId  String
  vendorProfile    VendorProfile      @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  favorite         Boolean            @default(false)
  buyerLastReadAt  DateTime?
  sellerLastReadAt DateTime?
  clientThreadId   String?            @unique
  subject          String?
  productId        String?
  productName      String?
  status           ConversationStatus @default(OPEN)
  messages         ChatMessage[]

  @@index([buyerUserId, updatedAt])
  @@index([vendorProfileId, updatedAt])
  @@index([buyerUserId, vendorProfileId, status, updatedAt])
  @@index([vendorProfileId, productId, updatedAt])
}

model ChatMessage {
  id              String          @id @default(uuid())
  createdAt       DateTime        @default(now())
  conversationId  String
  conversation    Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  clientMessageId String?
  senderUserId    String
  sender          User            @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  kind            ChatMessageKind
  text            String?
  imageUri        String?
  invoiceId       String?
  invoice         GoodsInvoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  productContext  Json?

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([senderUserId, createdAt])
}

model ProductLike {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, createdAt])
  @@index([userId, createdAt])
}

model CommerceCartItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  vendorId         String
  vendorName       String
  name             String
  subtitle         String
  imageUri         String
  sku              String
  unitPrice        Int
  originalPrice    Int?
  quantity         Int
  selectedColor    String?
  selectedSize     String?
  selectedVariants Json    @default("{}")
  deliveryAddress  String

  @@index([userId, createdAt])
  @@index([productId])
}

model CommerceOrder {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  //Payment
  paymentReference String? @unique
  paymentStatus    String  @default("pending")

  //make user id optional for guest purchase
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  guestFirstName String?
  guestLastName  String?
  guestEmail     String?
  guestPhone     String?

  deliveryAddress String
  latitude        Float
  longitude       Float
  paymentMethod   String
  status          String @default("confirmed")
  subtotal        Int
  serviceFee      Int
  deliveryFee     Int
  total           Int

  items                 CommerceOrderItem[]
  issues                OrderIssue[]
  returnRequests        ReturnRequest[]
  trustReviews          VendorTrustReview[]
  fulfillments          SellerFulfillment[]
  invoices              GoodsInvoice[]
  checkoutKey           String?             @unique
  guestInvoiceTokenHash String?
  supportTickets        SupportTicket[]

  @@index([userId, createdAt])
  @@index([status])
}

model CommerceOrderItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  orderId String
  order   CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  sourceCartItemId String?

  appliedOfferId String?

  productId        String
  vendorId         String
  vendorName       String
  name             String
  subtitle         String
  imageUri         String
  sku              String
  unitPrice        Int
  originalPrice    Int?
  quantity         Int
  selectedColor    String?
  selectedSize     String?
  selectedVariants Json    @default("{}")
  deliveryAddress  String

  returnItems ReturnRequestItem[]

  @@index([orderId])
  @@index([productId])
}

model VendorTrustReview {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewerUserId  String
  reviewer        User               @relation("TrustReviewer", fields: [reviewerUserId], references: [id], onDelete: Cascade)
  vendorProfileId String
  vendorProfile   VendorProfile      @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  orderId         String
  order           CommerceOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason          String
  rating          Int?
  votes           VendorReviewVote[]

  @@unique([reviewerUserId, vendorProfileId, orderId])
  @@index([vendorProfileId, createdAt])
  @@index([orderId])
}

model VendorReviewVote {
  id       String            @id @default(uuid())
  userId   String
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId String
  review   VendorTrustReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  helpful  Boolean

  @@unique([userId, reviewId])
  @@index([reviewId])
}

model OrderIssue {
  id          String            @id @default(uuid())
  createdAt   DateTime          @default(now())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String
  order       CommerceOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId      String?
  type        String
  description String
  status      String            @default("reported")
  replies     OrderIssueReply[]

  @@index([userId, createdAt])
  @@index([orderId])
}

model SellerFulfillment {
  id              String                   @id @default(uuid())
  orderId         String
  order           CommerceOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorId        String
  status          String                   @default("pending")
  rejectionReason String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  history         SellerFulfillmentEvent[]
  deliveryRequest DeliveryRequest?

  @@unique([orderId, vendorId])
  @@index([vendorId, updatedAt])
}

model SellerFulfillmentEvent {
  id            String            @id @default(uuid())
  fulfillmentId String
  fulfillment   SellerFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)

  status String
  reason String?

  actorUserId String?
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([fulfillmentId, createdAt])
}

model OrderIssueReply {
  id           String     @id @default(uuid())
  issueId      String
  issue        OrderIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorUserId String
  text         String?
  evidenceUrls String[]   @default([])
  createdAt    DateTime   @default(now())

  @@index([issueId, createdAt])
}

model DeliveryRequest {
  id            String            @id @default(uuid())
  fulfillmentId String            @unique
  fulfillment   SellerFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  provider      String            @default("mock")
  serviceLevel  String
  status        String            @default("assigned")
  fee           Int
  etaMinutes    Int
  trackingCode  String            @unique
  rider         Json
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model SupportTicket {
  id          String           @id @default(uuid())
  ownerUserId String
  owner       User             @relation("SupportTicketOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  orderId     String?
  order       CommerceOrder?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  category    String
  subject     String
  status      String           @default("open")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  messages    SupportMessage[]

  @@index([ownerUserId, updatedAt])
  @@index([status, updatedAt])
}

model SupportMessage {
  id           String        @id @default(uuid())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderUserId String
  sender       User          @relation("SupportMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  senderRole   String
  text         String?
  attachments  Json          @default("[]")
  createdAt    DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model ReturnRequest {
  id          String              @id @default(uuid())
  createdAt   DateTime            @default(now())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String
  order       CommerceOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason      String
  description String
  status      String              @default("requested")
  items       ReturnRequestItem[]

  @@index([userId, createdAt])
  @@index([orderId])
}

model ReturnRequestItem {
  id              String            @id @default(uuid())
  returnRequestId String
  returnRequest   ReturnRequest     @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       CommerceOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity        Int

  @@index([returnRequestId])
  @@index([orderItemId])
}

model SellerNotificationRead {
  userId String
  key    String
  readAt DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

model SellerNotificationSettings {
  userId           String   @id
  orders           Boolean  @default(true)
  priceSuggestions Boolean  @default(true)
  inventoryAlerts  Boolean  @default(true)
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MerchantContact {
  userId     String
  merchantId String
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant   VendorProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@id([userId, merchantId])
  @@index([merchantId])
}

model MerchantContent {
  id            String        @id @default(uuid())
  createdAt     DateTime      @default(now())
  merchantId    String
  merchant      VendorProfile @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  kind          String
  topic         String        @default("UPDATE")
  title         String
  caption       String        @default("")
  mediaUrl      String
  mediaType     String
  mediaPublicId String

  @@index([merchantId, kind, createdAt])
  @@index([kind, createdAt])
}

model ProductReview {
  id            String              @id @default(uuid())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  productId     String
  userId        String
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String
  mediaUrl      String?
  mediaType     String?
  mediaPublicId String?
  votes         ProductReviewVote[]

  @@unique([productId, userId])
  @@index([productId, createdAt])
}

model MerchantPaymentConnection {
  id              String         @id @default(uuid())
  vendorProfileId String
  vendorProfile   VendorProfile  @relation(fields: [vendorProfileId], references: [id], onDelete: Restrict)
  encryptedKey    String
  enabled         Boolean        @default(true)
  mode            String
  createdAt       DateTime       @default(now())
  invoices        GoodsInvoice[]

  @@index([vendorProfileId, enabled])
}

model GoodsInvoice {
  id                    String                     @id @default(uuid())
  number                String                     @unique
  orderId               String
  order                 CommerceOrder              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendorId              String
  vendorProfileId       String
  vendorProfile         VendorProfile              @relation(fields: [vendorProfileId], references: [id], onDelete: Restrict)
  bank                  Json
  subtotal              Int
  deliveryFee           Int
  total                 Int
  status                String                     @default("OPEN")
  paymentMethod         String                     @default("bank")
  createdAt             DateTime                   @default(now())
  expiresAt             DateTime
  paidAt                DateTime?
  paymentIssue          String?
  receiptNumber         String?                    @unique
  confirmationReference String?
  confirmedBy           String?
  checkoutReference     String?                    @unique
  checkoutEmail         String?
  checkoutUrl           String?
  connectionId          String?
  connection            MerchantPaymentConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  messages              ChatMessage[]
  reports               InvoiceTransferReport[]

  @@unique([orderId, vendorId])
  @@index([vendorId, status, createdAt])
  @@index([status, expiresAt])
}

model InvoiceTransferReport {
  id         String       @id @default(uuid())
  invoiceId  String
  invoice    GoodsInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  requestId  String
  reference  String
  note       String?
  status     String       @default("PENDING")
  createdAt  DateTime     @default(now())
  reviewedAt DateTime?
  reviewNote String?

  @@unique([invoiceId, requestId])
  @@index([invoiceId, status])
}

//comments
model ProductComment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  userId    String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  content String

  @@index([productId, createdAt])
  @@index([userId, createdAt])
}

model ProductReviewVote {
  id       String        @id @default(uuid())
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId String
  review   ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  helpful  Boolean

  @@unique([userId, reviewId])
  @@index([reviewId])
}
