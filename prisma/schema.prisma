// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  VENDOR
  BUSINESS
  ADMIN
}

enum RegistrationType {
  BUYER
  SELLER
  BUSINESS
}

enum AuthProvider {
  PHONE
  EMAIL
  GOOGLE
  APPLE
  FACEBOOK
}

enum EmailOtpPurpose {
  REGISTRATION
  EMAIL_CHANGE
  PASSWORD_RESET
}

enum PhoneOtpPurpose {
  PHONE_CHANGE
  REGISTRATION
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstName   String?
  lastName    String?
  dateOfBirth String?
  address     String?
  city        String?
  state       String?
  countryCode String?
  avatarUrl   String?

  email        String? @unique
  passwordHash String?

  phone        String?       @unique
  authProvider AuthProvider?

  registrationType RegistrationType?

  role UserRole @default(CUSTOMER)

  isVerified Boolean @default(false)
  isActive   Boolean @default(true)

  vendorProfile VendorProfile?
  wallet        Wallet?
  referrals     Referral[] @relation("Referrer")

  @@index([email])
  @@index([phone])
  @@index([registrationType])
  @@index([role])
}

enum WalletTransactionType {
  FUNDING
  PURCHASE
  REFERRAL_BONUS
  WITHDRAWAL
}

enum WalletTransactionStatus {
  COMPLETED
  FAILED
  PENDING
}

model Wallet {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableBalance Int    @default(0)
  mainBalance      Int    @default(0)
  referralBonus    Int    @default(0)
  accountName      String?
  accountNumber    String? @unique
  bankName         String?
  transactions     WalletTransaction[]
}

model WalletTransaction {
  id          String                  @id @default(uuid())
  createdAt   DateTime                @default(now())
  walletId    String
  wallet      Wallet                  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Int
  description String
  type        WalletTransactionType
  status      WalletTransactionStatus @default(COMPLETED)

  @@index([walletId, createdAt])
  @@index([status])
}

enum ReferralStatus {
  COMPLETED
  PENDING
}

model Referral {
  id             String         @id @default(uuid())
  createdAt      DateTime       @default(now())
  referrerUserId String
  referrer       User           @relation("Referrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  refereeName    String
  rewardAmount   Int            @default(500)
  status         ReferralStatus @default(PENDING)
  completedAt    DateTime?

  @@index([referrerUserId, createdAt])
  @@index([status])
}

model PhoneOtp {
  id         String          @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int             @default(0)
  verified   Boolean         @default(false)
  purpose    PhoneOtpPurpose @default(REGISTRATION)
  consumedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([phone, purpose])
}

model EmailOtp {
  id         String          @id @default(cuid())
  email      String
  userId     String?
  codeHash   String
  expiresAt  DateTime
  attempts   Int             @default(0)
  verified   Boolean         @default(false)
  consumedAt DateTime?
  purpose    EmailOtpPurpose
  createdAt  DateTime        @default(now())

  @@index([email, purpose])
  @@index([userId, purpose])
}

enum VendorReviewStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model VendorProfile {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeName         String
  category          String
  subCategory       String
  state             String
  city              String
  lga               String
  address           String
  landmark          String?
  description       String
  logoUrl           String?
  bannerUrl         String?
  cacUrl            String?
  bankName          String?
  bankCode          String?
  bankAccountNumber String?
  bankAccountName   String?
  sellerType        String?
  termsAcceptedAt   DateTime?
  submittedAt       DateTime?
  reviewStatus      VendorReviewStatus @default(DRAFT)
  setupCompleted    Boolean            @default(false)

  products Product[]

  @@index([category])
  @@index([state, city])
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model Product {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  category  String
  name      String
  unitPrice Int
  quantity  Int
  variants  Json          @default("[]")
  imageUrls String[]
  status    ProductStatus @default(ACTIVE)

  @@index([vendorProfileId, status])
  @@index([category])
  @@index([createdAt])
}
